# personal-rag — NVIDIA Jetson Orin Nano Super (JetPack 6.2, aarch64, CUDA 12.6)
#
# IMPORTANT: Build and run ON the Jetson itself.
# PyTorch wheels from pypi.jetson-ai-lab.io are aarch64-only.
#
# Build from the project root:
#   docker build -f docker/Dockerfile.jetson -t personal-rag:jetson .
#   make build-jetson
#
# Requires NVIDIA Container Toolkit:
#   https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/install-guide.html

# Base on NVIDIA's L4T JetPack image (Ubuntu 22.04 + CUDA 12.6 + cuDNN + TensorRT).
# A plain ubuntu base lacks the CUDA runtime libs (libcudart/libcublas/libcudnn)
# the jetson-ai-lab torch wheel needs — JetPack 6 does not inject them at runtime.
FROM nvcr.io/nvidia/l4t-jetpack:r36.4.0

ARG DEBIAN_FRONTEND=noninteractive

# Install cuDSS (CUDA Direct Sparse Solver) before other packages.
# torch 2.8+ on JetPack 6 requires libcudss.so.0. It is NOT in Ubuntu Ports or the CUDA sbsa
# repo. NVIDIA ships it as a Jetson/Tegra-specific local .deb installer only.
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates \
    && wget -q https://developer.download.nvidia.com/compute/cudss/0.7.1/local_installers/cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb \
    && dpkg -i cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb \
    && cp /var/cudss-local-tegra-repo-ubuntu2204-0.7.1/cudss-*-keyring.gpg /usr/share/keyrings/ \
    && rm cudss-local-tegra-repo-ubuntu2204-0.7.1_0.7.1-1_arm64.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-dev python3-pip gcc libopenblas-dev \
        cudss tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/local/bin/python \
    && ln -sf /usr/bin/pip3 /usr/local/bin/pip

WORKDIR /app

# PyTorch must come first — standard PyPI wheels are x86 only.
# This layer is ~1.5 GB and is cached after the first build.
RUN pip install --no-cache-dir torch torchvision \
    --index-url https://pypi.jetson-ai-lab.io/jp6/cu126

# Dependency layer first — cached across source-only changes.
# Ubuntu 22.04 ships pip 22 / setuptools 59 — too old for PEP 660 editable
# installs, so upgrade the toolchain here.
COPY requirements-jetson.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip "setuptools<82" wheel \
 && pip install --no-cache-dir -r requirements-jetson.txt

COPY pyproject.toml ./
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY config.yaml .env.example ./

# Editable install must come AFTER src/ exists: this is a src-layout package,
# so setuptools puts egg-info under src/ and errors out if the dir is missing.
# --no-build-isolation reuses the setuptools installed above as the backend.
RUN pip install --no-cache-dir -e . --no-deps --no-build-isolation

ENV HF_HOME=/data/hf-cache
ENV TRANSFORMERS_CACHE=/data/hf-cache
ENV RAG_INDEX_PATH=/data/chroma

CMD ["python", "-m", "rag.query", "--help"]
