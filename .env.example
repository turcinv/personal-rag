# personal-rag — environment variable overrides
#
# Copy this file to .env and fill in your paths.
# .env is gitignored — never commit it.
#
# These variables override the corresponding paths in config.yaml without
# requiring any edits to the config file itself. Useful when the repo is
# shared across machines with different drive mount points.

# RAG_VAULT_PATH=/path/to/your/Obsidian Vault/
# RAG_PDF_BOOKS_PATH=/path/to/your/Books/
# RAG_PDF_RESOURCES_PATH=/path/to/your/Resources/
# RAG_JSON_PATH=/path/to/knowledge-base-index/indexed   # pre-extracted book/resource JSON
# RAG_INDEX_PATH=/data/chroma   # override ChromaDB storage path (set automatically in Docker)
# RAG_LOG_PATH=/data/logs/rag.log  # override app log file path (set automatically in Docker)

# Extractor pipeline — HOST-side paths for docker-compose.jetson.yml / docker-compose.yml
# volume mounts (jetson-extract/-enrich/-build-index/-build-notes/-pipeline-status targets).
# These are a DIFFERENT layer from the RAG_* vars above: the ones above are read directly
# by the Python app (via rag.utils.load_config); these below are read by Docker Compose
# itself at the HOST shell level to resolve `${VAR:-/tmp}` in the `volumes:` section. If
# unset, Compose silently falls back to mounting the host's /tmp (empty) into the
# container, and every extractor pipeline step will report MISSING even though the data
# exists on disk — it just isn't mounted. Keep these in sync with JETSON_OUTPUT_PATH below
# after every `make sync-to-jetson` (same directory, since that's what got rsynced there).
# RAG_OUTPUT_PATH=/path/to/knowledge-base-index          # text_output/, indexed/, resources.db
# RAG_CATALOG_PATH=/path/to/Career Knowledge Base/Resources/_catalog
# RAG_MOCS_PATH=/path/to/Career Knowledge Base/Resources/Generated
# RAG_OBSIDIAN_NOTES_PATH=/path/to/Career Knowledge Base/Resources/Generated/Resource Notes

# Backend API (rag-serve / make serve / docker-serve / jetson-serve) — ONLY the API
# server needs these; the indexer and query CLIs ignore them. RAG_API_JWT_SECRET is
# REQUIRED to serve (protected routes return 500 if unset) — use a strong secret,
# ≥32 bytes (PyJWT warns on short HS256 keys), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mint bot tokens with the same secret: RAG_API_JWT_SECRET=... rag-token --subject telegram-bot
# RAG_API_JWT_SECRET=change-me-to-a-long-random-secret
# RAG_API_HOST=0.0.0.0   # uvicorn bind address (default 0.0.0.0)
# RAG_API_PORT=8000      # uvicorn bind port (default 8000)

# Jetson sync target (used by make sync-to-jetson)
# JETSON_HOST=turcinv@gpu-01               # SSH host (name or user@host)
# JETSON_OUTPUT_PATH=~/knowledge-base-index  # destination path on the Jetson host
# On the Jetson itself, set RAG_OUTPUT_PATH/RAG_JSON_PATH above to this same path
# (and RAG_JSON_PATH to "$JETSON_OUTPUT_PATH/indexed") or the mounts above will miss it.
